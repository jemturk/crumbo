{
  "expo": {
    "name": "Crumbo",
    "slug": "Crumbo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "crumbo",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/logo.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.jemturk.Crumbo"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFDF3",
        "foregroundImage": "./assets/images/logo-transparent.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jemturk.crumbo",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFC93C",
          "image": "./assets/images/logo.png",
          "imageWidth": 150
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fe5da923-09c1-4999-b09c-3d2a84c7e368"
      }
    }
  }
}
