{
  "expo": {
    "name": "Crumbo",
    "slug": "Crumbo",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "crumbo",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/logo.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.jemturk.Crumbo"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFDF3",
        "foregroundImage": "./assets/images/logo-transparent.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jemturk.crumbo",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.BIND_TELECOM_CONNECTION_SERVICE",
        "android.permission.MANAGE_OWN_CALLS",
        "android.permission.READ_CALL_LOG",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_PHONE_CALL",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFC93C",
          "image": "./assets/images/logo.png",
          "imageWidth": 150
        }
      ],
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Crumbo to access your camera for video calls.",
          "microphonePermission": "Allow Crumbo to access your microphone for voice calls."
        }
      ],
      "@config-plugins/react-native-callkeep",
      "./plugins/withCallkeepSelfManagedPermissions.js",
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fe5da923-09c1-4999-b09c-3d2a84c7e368"
      }
    }
  }
}
